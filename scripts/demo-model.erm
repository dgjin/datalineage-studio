<?xml version="1.0" encoding="UTF-8"?>
<diagram>
  <contents>
    <table>
      <physical_name>ods_customers</physical_name>
      <logical_name>客户表</logical_name>
      <description>ODS 层客户原始数据</description>
      <columns>
        <normal_column>
          <physical_name>cust_id</physical_name>
          <type>varchar</type>
          <length>64</length>
          <not_null>true</not_null>
          <primary_key>true</primary_key>
          <description>客户ID</description>
        </normal_column>
        <normal_column>
          <physical_name>cust_name</physical_name>
          <type>varchar</type>
          <length>128</length>
          <not_null>true</not_null>
          <primary_key>false</primary_key>
          <description>客户姓名</description>
        </normal_column>
        <normal_column>
          <physical_name>phone</physical_name>
          <type>varchar</type>
          <length>32</length>
          <not_null>false</not_null>
          <primary_key>false</primary_key>
          <description>手机号</description>
        </normal_column>
        <normal_column>
          <physical_name>email</physical_name>
          <type>varchar</type>
          <length>128</length>
          <not_null>false</not_null>
          <primary_key>false</primary_key>
          <description>邮箱</description>
