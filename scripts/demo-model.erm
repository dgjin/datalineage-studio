        </normal_column>
        <normal_column>
          <physical_name>created_at</physical_name>
          <type>datetime</type>
          <not_null>true</not_null>
          <primary_key>false</primary_key>
          <description>创建时间</description>
        </normal_column>
      </columns>
    </table>
    <table>
