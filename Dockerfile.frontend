# DataLineage Studio Frontend Dockerfile
# Multi-stage: Vite build on Node, then nginx serves the bundle and acts as
# the API gateway in front of the backend pool (see nginx.conf / compose files).

# ---- Stage 1: build the Vite bundle ----
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first so the layer is cached across source changes.
# --legacy-peer-deps: the lockfile ships an esbuild 0.25 devDependency next to
# vite 8's optional esbuild ^0.27 peer - same resolution the dev machines use.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --legacy-peer-deps

# Only the files vite build needs
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src

RUN npm run build

# ---- Stage 2: serve via nginx ----
FROM nginx:1.27-alpine

# Rendered to /etc/nginx/conf.d/default.conf at container start (envsubst):
# ${BACKEND_SERVERS} carries the upstream pool so the same image works for
# the single-node and the HA compose stacks.
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html

# Default topology: two backend instances (docker-compose.ha.yml).
ENV BACKEND_SERVERS="server backend-1:8080; server backend-2:8080;"

EXPOSE 80

# 127.0.0.1 (not localhost): inside the container localhost resolves to ::1
# and nginx only listens on IPv4
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/healthz || exit 1
